# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/openjdk_jobs
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/openjdk_jobs
MONGO_URI=mongodb://localhost:27017/openjdk_jobs

# Server Port
PORT=3001

# Jenkins CI Base URL
JENKINS_BASE_URL=https://ci.adoptium.net

# Pipeline Job Path (e.g., job/build-scripts/job/weekly-openjdk21-pipeline)
PIPELINE_JOB_PATH=job/build-scripts/job/weekly-openjdk21-pipeline
